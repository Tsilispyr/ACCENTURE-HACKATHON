# Copy to .env, fill in the four AZURE_* values, and you are done:
#     cp .env.example .env
# scripts/deploy.sh does this for you and prompts for anything still blank.
#
# Everything below the AZURE block is shared on purpose -- these are local-only
# demo credentials, identical on every machine, so all developers get the same
# environment. They are NOT secrets: the Langfuse keys are re-seeded from
# docker-compose-langfuse.yaml's LANGFUSE_INIT_PROJECT_* on any fresh database,
# and the MinIO pair is that file's MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
# Every one of those services is bound to 127.0.0.1 on the host.

# --- filled once by the user (the only genuinely personal credentials) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME=

# --- Langfuse: tracing. Must match docker-compose-langfuse.yaml's
#     LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY, or tracing silently
#     no-ops on a fresh database (tracing.py returns [] when either is unset).
LANGFUSE_PUBLIC_KEY="pk-lf-35e3bc70-ee1d-4ca7-a974-784defdf3366"
LANGFUSE_SECRET_KEY="sk-lf-2c2ca70a-090b-4e02-ac9d-0ce151a6376c"
# localhost:3000 is right for local `uv run uvicorn` dev; docker-compose.yml
# overrides both to http://langfuse-web:3000 for the in-network case.
LANGFUSE_HOST="http://localhost:3000"
LANGFUSE_BASE_URL="http://localhost:3000"

# --- MinIO: resolution-report storage. The bucket is created on first upload
#     by storage.py, so there is no manual setup step.
# localhost:9090 for local dev (MinIO's S3 API is published 9090:9000);
# docker-compose.yml overrides this to minio:9000 inside the network.
MINIO_ENDPOINT="localhost:9090"
MINIO_ACCESS_KEY="minio"
MINIO_SECRET_KEY="miniopassQWqw!@12"
MINIO_BUCKET="hackathon1-reports"

# --- Simulation data (optional) ---
# world.py loads the incident simulation's ground truth from a knowledge base:
# services, metrics baselines, logs, runbooks and incident history.
#
# Leave this UNSET for normal use. It defaults to the copy packaged with the
# code at src/hackathon1/data/scenarios.json, which is what ships in the Docker
# image, so nothing needs configuring.
#
# Set it only to point at a different knowledge base -- e.g. if the organisers
# hand over a hidden scenario file. If you set it while running in Docker the
# path must be reachable INSIDE the container, so bind-mount the file first;
# a Windows or WSL host path will not resolve on its own.
# SCENARIOS_PATH="/app/src/hackathon1/data/scenarios.json"

# --- Durable checkpointing (optional locally) ---
# The workflow pauses for human approval; with in-memory state that pause dies
# with the process. In Docker these are supplied by docker-compose.yml. For
# local `uv run uvicorn`, point at the published host port instead -- note 5433,
# not 5432, to avoid clashing with a locally installed Postgres.
POSTGRES_HOST="localhost"
POSTGRES_PORT="5433"
POSTGRES_USER="gtgh"
POSTGRES_PASSWORD="postgrepassQWqw!@12"
CHECKPOINT_DATABASE="hackathon1"

APP_ENV=development
LOG_LEVEL=INFO
