# Copy to .env and fill in real values (or copy from ../day21/.env for the
# Azure OpenAI key -- company-provided, same across every day folder, not
# something that changes per-project). Never commit .env (see
# notes/02-METHODOLOGY.md section 2).

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME=

# Must match project/.env's LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY --
# this app authenticates against the Langfuse project self-seeded by the
# infra stack (docker-compose-langfuse.yaml) using those same keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# localhost:3000 -- correct default for local `uv run uvicorn` dev, since
# docker-compose-langfuse.yaml publishes langfuse-web on the host at
# 3000:3000. Running via docker-compose.yml overrides this automatically to
# the in-network DNS name "langfuse-web" -- this value only matters locally.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_BASE_URL=http://localhost:3000

# Root credentials hardcoded in project/docker-compose-langfuse.yaml
# (MINIO_ROOT_USER / MINIO_ROOT_PASSWORD) -- copy them from there.
# localhost:9090 -- correct for local dev (MinIO's S3 API is published at
# 9090:9000 on the host); Docker overrides this to "minio:9000" the same way
# LANGFUSE_HOST is overridden above.
MINIO_ENDPOINT=localhost:9090
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=hackathon1-reports

APP_ENV=development
LOG_LEVEL=INFO
