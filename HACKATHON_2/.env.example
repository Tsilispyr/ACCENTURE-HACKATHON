# hackathon2 - copy to .env and fill the blanks. scripts/preflight.sh does
# this for you on first run and prompts once for anything still empty.
#
# Values that ship filled in are local-demo-only and safe to commit.
# Anything blank is personal and must never be committed.

# ---------------------------------------------------------------- Azure OpenAI
# Chat model. preflight.sh prompts for these four.
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_VERSION="2024-12-01-preview"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4.1-mini"

# Embeddings use a SEPARATE endpoint and key on this subscription - not the
# chat ones. Getting this wrong is the single most common setup failure.
AZURE_EMBEDDING_ENDPOINT=""
AZURE_EMBEDDING_API_KEY=""
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"

# The judge that grades evaluation runs. Left blank it falls back to the chat
# deployment above, which is the usual setup - point it at a DIFFERENT model
# if you have one, since a model grading its own output is a weak check.
AZURE_OPENAI_JUDGE_DEPLOYMENT=""

# -------------------------------------------------------------------- Langfuse
# OPTIONAL. The hosted development view: one run's prompts and outputs, read
# while building. The course's guide 04 is the Langfuse guide and this is the
# team's choice.
#
# Leave these blank and nothing is sent anywhere. The ALWAYS-ON layer is the
# LangGraph audit trail, which needs no account, no container and no network:
#
#     uv run python -m agentcore.tracing "your question"
#
# Blank host defaults to Langfuse Cloud; point it at a self-hosted instance if
# the team runs one. /healthz reports tracing_enabled. DECISIONS D49.
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# ------------------------------------------------- Azure Monitor / App Insights
# The OPERATIONAL view, alongside Langfuse rather than instead of it: latency,
# failure rates, exceptions and evaluation results across many runs. Span names
# are the nine pipeline stages, so a trace reads s1_intake -> ... -> s9_guard_out.
#
# Blank turns it off entirely, which is the normal state on a laptop. Paste the
# connection string from the App Insights resource overview to turn it on.
# /healthz reports azure_monitor_enabled, so a dead exporter stays visible.
APPLICATIONINSIGHTS_CONNECTION_STRING=""
OTEL_SERVICE_NAME="hackathon2"

# --------------------------------------------------------------------- Postgres
# pgvector store + LangGraph checkpoints. 5446 avoids every port already taken
# on this machine: 5432/5433 (hackathon1), 5442/5444/5445 (course units).
POSTGRES_HOST="localhost"
POSTGRES_PORT="5446"
POSTGRES_USER="h2"
POSTGRES_PASSWORD="h2passQWqw12"
POSTGRES_DB="hackathon2"
VECTOR_COLLECTION="corpus"

# ------------------------------------------------------------- Vector backend
# pgvector needs the container above. chroma runs in-process from a local
# directory and needs nothing running, which is why it is the fallback whenever
# WSL port forwarding misbehaves. Same pipeline, same embeddings, and the two
# measured identically on the GDPR corpus - see DECISIONS.md.
VECTOR_BACKEND="pgvector"
CHROMA_DIR=".chroma"

# ------------------------------------------------------------------------ Neo4j
# INERT. No container runs one any more (DECISIONS D48): vendor_risk's
# GRAPH_QUERIES is empty, so nothing ever queried it, and it cost ~768MB of a
# 3.6GB WSL budget to sit idle.
#
# These stay documented because `rag/graphstore.py` still reads them and the
# graph seam is still part of the domain Protocol, so a scenario that wants a
# graph arm can bring its own Neo4j and fill these in. Point them at one and
# the tool works; leave them and the tool reports the graph unavailable and
# tells the agent to use search_corpus instead.
NEO4J_URI="bolt://localhost:7688"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="h2neo4jpass"

# -------------------------------------------------------------------------- MCP
# stdio spawns the server as a subprocess (tests, local dev).
# http talks to the mcp-systems container over the compose network.
MCP_MODE="stdio"
MCP_TRANSPORT="stdio"
MCP_URL="http://h2-mcp-systems:8100/mcp"
# The port the server BINDS. Must match the port inside MCP_URL above.
MCP_PORT="8100"

# -------------------------------------------------------------------------- App
# Which domain package the whole system runs as. This is THE swap point.
DOMAIN="sample_policy"

APP_ENV="development"
LOG_LEVEL="INFO"
APP_PORT="8020"

# Signs session tokens. preflight.sh generates one if left blank.
APP_SECRET=""
