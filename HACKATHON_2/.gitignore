# Secrets - never commit real values.
.env
*.env
.env.*
!.env.example

# Per-run deploy logs - numbered, kept locally
logs/

# Build artefacts of the RAG pipeline: all of these regenerate from the corpus.
.cache/
build/
# The local vector store: 8.7 MB of binary index, rebuilt by scripts/index.sh.
# .chroma/ IS COMMITTED, deliberately. It is the built index for the supplied
# knowledge pack, 9.4MB, and committing it means a clone runs immediately:
#
#     DOMAIN=vendor_risk VECTOR_BACKEND=chroma uv run python -m agentcore.console
#
# with no Postgres, no container and no embedding calls. That matters more here
# than repository hygiene: the infra has proven flaky on a 3GB WSL, and the one
# thing nobody should be debugging on the day is why retrieval is empty.
#
# Rebuild it with `python -m agentcore.rag.index --reset` after any change to
# docs/. If it is stale, every number measured from it is stale too, which is
# why CORPUS.md makes reindexing step 2 rather than an afterthought.

# Chainlit writes its own config and ~30 translation files on first run.
.chainlit/

# Evaluation OUTPUT is kept - the ledger and the charts are the evidence, and
# a number on a slide should be traceable to a committed file. Gate reports are
# one JSON per run and would bury the ledger, so those are not.
evaluation-results/reports/

# Python
__pycache__/
*.py[oc]
dist/
wheels/
*.egg-info
.venv/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Office lock files. Created while a .pptx or .docx is OPEN, and they are
# invisible in Explorer, so they get committed by accident.
~$*

# The deck is BUILT, not stored. team-docs/build_deck.py is the source of
# truth and re-renders it from the ledger; a committed .pptx goes stale the
# moment the numbers move, and a binary in git cannot be reviewed in a diff.
team-docs/*.pptx

# The share bundle: copies of files that live elsewhere, plus the built deck.
# Rebuilt on demand, never the source of truth.
team-docs/share/
team-docs/*.zip
